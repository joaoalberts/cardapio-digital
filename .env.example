# Copie para .env.local.
# Token do NocoDB com acesso à base "Cardápio Digital".
NOCODB_API_TOKEN=
# Vercel Blob (fotos e logos): Vercel > Storage > Blob, depois "vercel env pull".
BLOB_READ_WRITE_TOKEN=

# Sugestão automática de traduções no painel (opcional). Sem ela, o dono traduz à mão.
ANTHROPIC_API_KEY=

# Senha do cron diário da Comunidade (/api/cron/comunidade, vercel.json). O João cria um
# valor longo e aleatório na Vercel (Settings > Environment Variables); sem ela o cron
# responde 503 e a retenção não roda.
CRON_SECRET=

# Onde ficam as fotos: vazio = Vercel Blob (produção). "local" grava em .local-blob/ e
# serve por /api/arquivos-locais: só para teste na máquina ou no Docker, nunca na Vercel.
STORAGE_DRIVER=

# Apareça na TV. Chave geral: APARECA_OFF=1 desliga o recurso em todos os restaurantes.
APARECA_OFF=
# Teto de gasto do Mux por mês, em dólares (padrão 15). Aviso no painel a partir de 75%; envios pausados a partir de 90%.
APARECA_TETO_USD=
# Modelo da moderação por IA (padrão claude-haiku-4-5). Só vale se o João liberar a IA no restaurante e houver ANTHROPIC_API_KEY.
APARECA_AI_MODEL=
# E-mails (separados por vírgula) que veem o painel de super admin (/painel/apareca/admin), onde o João libera o
# Apareça e a IA por restaurante. Vazio = ninguém. O valor real fica só na Vercel (Settings > Environment Variables)
# e no .env.local, nunca em arquivo versionado.
# Crie e entre na sua conta ANTES de pôr o e-mail aqui; o cadastro não confirma e-mail.
SUPERADMIN_EMAILS=
# Opcional (data ISO, ex.: 2026-10-20T00:00:00Z): só vale como super admin a conta criada ANTES dessa data.
# Ponha a data de hoje depois de criar a sua conta: ninguém consegue cadastrar o seu e-mail depois e virar super admin.
SUPERADMIN_SINCE=
